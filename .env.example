# OneShow Environment Variables

# The Movie Database (TMDB) API
# Obtain your API Read Access Token from https://www.themoviedb.org/settings/api
TMDB_API_READ_ACCESS_TOKEN=your_tmdb_api_read_access_token_here

# Supabase (Configured in upcoming milestone)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
